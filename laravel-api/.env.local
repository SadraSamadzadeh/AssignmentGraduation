# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ============================================================================
# This configuration uses Docker Compose (no Kubernetes needed)
# Simple setup: docker-compose up

APP_NAME="USF Sport Assignment"
APP_ENV=local
APP_KEY=base64:YourSecretAppKeyHere1234567890ABCDEF
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database - Docker Compose Service
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=assignment_graduation
DB_USERNAME=assignment_user
DB_PASSWORD=postgres_password_123

# Cache & Session
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis - Docker Compose Service
REDIS_HOST=redis
REDIS_PASSWORD=redis_password_123
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Queue - RabbitMQ Docker Compose Service
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=rabbitmq_password_123
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

# Mail (Development - Use Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (Optional - for local testing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
